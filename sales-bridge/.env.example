# Mesmo Supabase do Deskcomm (copie do .env do Deskcomm: NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Segredo compartilhado com o painel (gere com: openssl rand -hex 32). O MESMO valor vai em ATENDIMENTO_SEGREDO no painel.
SALES_BRIDGE_SECRET=
# UUID do administrador da plataforma do Deskcomm (o primeiro admin criado pelo instalador): Supabase → Authentication → Users → UID.
SALES_ACTOR_ID=
# Endereço público do Deskcomm.
DESKCOMM_PUBLIC_URL=https://atendimento.seudominio.com.br
PORT=3900
